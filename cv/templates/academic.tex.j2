  pdftitle={((( personal.name ))) -- Curriculum Vitae},
  pdfauthor={((( personal.name )))},
  pdfsubject={Academic curriculum vitae},
  pdfkeywords={((( research_interests | join(', ') )))}]{hyperref}

% ---- Fonts: Spectral, every weight a real face (no synthesized bold/italic) ----
\defaultfontfeatures{Path=((( fontdir ))), Extension=.ttf, Ligatures=TeX}
\setmainfont{Spectral}[
  UprightFont=*-Regular, ItalicFont=*-Italic,
  BoldFont=*-SemiBold, BoldItalicFont=*-MediumItalic,
  Numbers=OldStyle]
\newfontfamily\medium{Spectral}[UprightFont=*-Medium, ItalicFont=*-MediumItalic, Numbers=OldStyle]
\newfontfamily\heavy{Spectral}[UprightFont=*-SemiBold, Numbers=Lining]
\newfontfamily\lining{Spectral}[UprightFont=*-Regular, ItalicFont=*-Italic, Numbers={Lining,Monospaced}]

% ---- Palette ----
\definecolor{ink}{HTML}{1C1C1A}
\definecolor{body}{HTML}{2B2B28}
\definecolor{muted}{HTML}{5C5C58}
\definecolor{faint}{HTML}{8A8A85}
\definecolor{accent}{HTML}{0F4C4F}
\definecolor{hair}{HTML}{D9D7CF}

% ---- Page ----
\setlength{\parindent}{0pt}
\setlength{\parskip}{0pt}
\fontsize{10}{13.4}\selectfont
\raggedbottom
\frenchspacing
\color{ink}
\clubpenalty=10000 \widowpenalty=10000

\makeatletter
\def\ps@cv{%
  \def\@oddhead{}\let\@evenhead\@oddhead
  \def\@oddfoot{\fontsize{7.8}{9}\selectfont\color{faint}%
    ((( personal.name )))\enspace\textperiodcentered\enspace Curriculum Vitae\enspace\textperiodcentered\enspace Updated ((( updated )))%
    \hfill{\lining\thepage\,/\,\pageref*{cv:last}}}%
  \let\@evenfoot\@oddfoot}
\makeatother
\pagestyle{cv}
\AtEndDocument{\label{cv:last}}

% ---- Building blocks ----
% Every block is one unbreakable box; \nointerlineskip + struts give an exact,
% uniform rhythm whether a block has one line or several.
\newlength{\datew}\setlength{\datew}{0.95in}
\newlength{\keyw}\setlength{\keyw}{0.66in}
\newcommand{\gap}[1]{\par\vspace{#1}\nointerlineskip}
\newcommand{\when}[1]{{\lining\fontsize{9}{11}\selectfont\color{faint}#1}}
\newcommand{\sep}{\enspace{\color{hair}|}\enspace}

% \cvsection{Title}: spaced capitals over a hairline, kept with the next block
\newcommand{\cvsection}[1]{%
  \par\addvspace{15pt}\nointerlineskip
  \noindent\parbox[t]{\linewidth}{\strut{\heavy\fontsize{8.6}{10}\selectfont\addfontfeatures{LetterSpace=16}%
    \color{accent}\MakeUppercase{#1}}\par\vspace{2.5pt}{\color{hair}\hrule height 0.5pt}}%
  \par\nobreak\vspace{7pt}\nobreak\nointerlineskip}

% \block{content}: one unbreakable paragraph box
\newcommand{\block}[1]{\noindent\parbox[t]{\linewidth}{\strut#1\ifhmode\strut\fi}\par}

% \head{left}{right}: title line with the period flush right
\newcommand{\head}[2]{%
  \parbox[t]{\dimexpr\linewidth-\datew}{\raggedright\strut#1\strut}%
  \makebox[\datew][r]{\when{#2}}\par}

% \detail{key}{value}: labelled line with a hanging indent
\newcommand{\detail}[2]{%
  {\fontsize{9.3}{12.4}\selectfont\color{muted}\hangindent=\keyw\hangafter=1\noindent
   \makebox[\keyw][l]{\color{faint}\itshape #1}#2\strut\par}}

% \row{lead}{body}{tail}: one-line record in three columns
\newlength{\leadw}
\newcommand{\row}[3]{\fontsize{9.6}{12.9}\selectfont
  \noindent\parbox[t]{\leadw}{\raggedright\strut#1\strut}%
  \parbox[t]{\dimexpr\linewidth-\leadw-\datew}{\raggedright\strut\color{muted}#2\strut}%
  \parbox[t]{\datew}{\raggedleft\strut\when{#3}\strut}\par}

\begin{document}

% ================================ Header ================================
\noindent{\fontsize{30}{32}\selectfont\heavy ((( personal.name )))}\par
\vspace{6pt}
\noindent{\medium\itshape\fontsize{12.5}{15}\selectfont\color{accent}((( personal.headline )))}\par
\vspace{10pt}
{\color{accent}\hrule height 1.2pt}
\vspace{7pt}
{\fontsize{9}{13}\selectfont\color{muted}\noindent
