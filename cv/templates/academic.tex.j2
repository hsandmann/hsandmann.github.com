\sep\href{((( contact.website.url | url )))}{((( contact.website.label )))}%
\sep\href{((( contact.orcid.url | url )))}{ORCID {\lining ((( contact.orcid.label )))}}%
\sep\href{((( contact.scholar.url | url )))}{Google Scholar}%
\sep\href{((( contact.linkedin.url | url )))}{LinkedIn}%
\sep\href{((( contact.github.url | url )))}{GitHub}\par
